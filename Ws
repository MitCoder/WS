
"""Step 2: also count running instances, and decide how many to launch (dry run)."""
import json
import logging
import os
from abc import ABC, abstractmethod
from dataclasses import dataclass

import boto3

log = logging.getLogger()
log.setLevel(logging.INFO)


# ---------- Config ----------
@dataclass(frozen=True)
class Config:
    queue_url: str
    pool: str
    max_instances: int

    @classmethod
    def from_env(cls) -> "Config":
        return cls(
            queue_url=os.environ["QUEUE_URL"],
            pool=os.environ["POOL"],
            max_instances=int(os.environ.get("MAX_INSTANCES", "5")),
        )


# ---------- Interfaces ----------
class JobCounter(ABC):
    @abstractmethod
    def count_jobs(self) -> int:
        """Number of jobs waiting plus jobs being worked on."""


class InstanceRegistry(ABC):
    @abstractmethod
    def count_running(self) -> int:
        """Number of worker instances that are starting or running."""


# ---------- Adapters: AWS implementations ----------
class SqsJobCounter(JobCounter):
    def __init__(self, sqs_client, queue_url: str):
        self._sqs = sqs_client
        self._queue_url = queue_url

    def count_jobs(self) -> int:
        attrs = self._sqs.get_queue_attributes(
            QueueUrl=self._queue_url,
            AttributeNames=[
                "ApproximateNumberOfMessages",
                "ApproximateNumberOfMessagesNotVisible",
            ],
        )["Attributes"]
        return (int(attrs["ApproximateNumberOfMessages"])
                + int(attrs["ApproximateNumberOfMessagesNotVisible"]))


class Ec2InstanceRegistry(InstanceRegistry):
    """Counts instances tagged pool=<pool>. 'pending' counts so booting hosts are included."""

    def __init__(self, ec2_client, pool: str):
        self._ec2 = ec2_client
        self._pool = pool

    def count_running(self) -> int:
        pages = self._ec2.get_paginator("describe_instances").paginate(Filters=[
            {"Name": "tag:pool", "Values": [self._pool]},
            {"Name": "instance-state-name", "Values": ["pending", "running"]},
        ])
        return sum(len(r["Instances"]) for page in pages for r in page["Reservations"])


# ---------- Strategy with a Template Method ----------
class ScalingStrategy(ABC):
    def instances_to_launch(self, jobs: int, running: int) -> int:
        """Template method: the shared rule lives here, subclasses supply desired_instances."""
        return max(0, self.desired_instances(jobs) - running)

    @abstractmethod
    def desired_instances(self, jobs: int) -> int:
        """How many instances should exist for this many jobs."""


class CappedPerJobStrategy(ScalingStrategy):
    """One instance per job, never more than max_instances."""

    def __init__(self, max_instances: int):
        self._max_instances = max_instances

    def desired_instances(self, jobs: int) -> int:
        return min(self._max_instances, jobs)


# ---------- Service ----------
class ScalingService:
    def __init__(self, job_counter: JobCounter, registry: InstanceRegistry,
                 strategy: ScalingStrategy):
        self._job_counter = job_counter
        self._registry = registry
        self._strategy = strategy

    def run(self) -> dict:
        jobs = self._job_counter.count_jobs()
        running = self._registry.count_running()
        to_launch = self._strategy.instances_to_launch(jobs, running)
        return {"jobs": jobs, "running": running, "to_launch": to_launch}


# ---------- Factory ----------
def create_scaling_service(config: Config) -> ScalingService:
    return ScalingService(
        job_counter=SqsJobCounter(boto3.client("sqs"), config.queue_url),
        registry=Ec2InstanceRegistry(boto3.client("ec2"), config.pool),
        strategy=CappedPerJobStrategy(config.max_instances),
    )


# ---------- Lambda entry point ----------
def handler(event, context):
    result = create_scaling_service(Config.from_env()).run()
    log.info("result=%s", result)
    return result


# ---------- Local run ----------
if __name__ == "__main__":
    print(json.dumps(handler({}, None)))
