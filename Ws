#!/bin/bash
# Docker worker bootstrap. Rendered by Terraform templatefile().
# Variables: region queue_url data_bucket output_bucket dry_run image ecr_registry
#            job_timeout model_id haiku_model_id claude_args worker_py
exec > >(tee -a /var/log/worker.log) 2>&1
echo "=== worker bootstrap start $(date -u +%FT%TZ) ==="

# --- identity (IMDSv2) ---
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)

# --- always remove this instance when we are done (success, failure or timeout) ---
terminate_self() {
  echo "terminating $IID"
  aws autoscaling terminate-instance-in-auto-scaling-group \
    --region ${region} --instance-id "$IID" --should-decrement-desired-capacity || true
  sleep 60
  shutdown -h now
}
trap terminate_self EXIT

# --- tools ---
dnf install -y python3-boto3

if [ "${dry_run}" != "1" ]; then
  dnf install -y docker
  systemctl enable --now docker
  aws ecr get-login-password --region ${region} \
    | docker login --username AWS --password-stdin ${ecr_registry}
  docker pull ${image}
fi

# --- worker.py (embedded, so it needs no S3 download) ---
mkdir -p /opt/worker
cat > /opt/worker/worker.py <<'WORKER_PY_EOF'
${worker_py}
WORKER_PY_EOF

# --- settings for worker.py ---
export AWS_REGION="${region}"
export QUEUE_URL="${queue_url}"
export DATA_BUCKET="${data_bucket}"
export OUTPUT_BUCKET="${output_bucket}"
export DRY_RUN="${dry_run}"
export RUNNER="docker"
export IMAGE="${image}"
export JOB_TIMEOUT="${job_timeout}"
export MODEL_ID="${model_id}"
export HAIKU_MODEL_ID="${haiku_model_id}"
export CLAUDE_ARGS='${claude_args}'

# --- run one job; the trap terminates the instance afterwards ---
timeout $(( ${job_timeout} + 900 )) python3 /opt/worker/worker.py
echo "=== worker finished, exit $? ==="

