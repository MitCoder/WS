verify-payload:
  extends: .dind
  stage: verify
  needs: [build-payload]
  script:
    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD" "$CI_REGISTRY"
    - docker pull "$PAYLOAD_IMAGE:$CI_COMMIT_SHORT_SHA"

    # 1. Real app-style image: files present, and fails fast without TEAM_NAME
    - |
      cat > Dockerfile.verify <<EOF
      FROM $PAYLOAD_IMAGE:$CI_COMMIT_SHORT_SHA AS defender
      FROM $TEST_JAVA_BASE
      COPY --from=defender /defender/ /tmp/
      ENTRYPOINT ["/tmp/defender-entry.sh"]
      CMD ["java","-version"]
      EOF
    - docker build -t verify-app -f Dockerfile.verify .
    - docker run --rm --entrypoint sh verify-app -c 'ls -l /tmp/defender /tmp/defender-entry.sh /tmp/defender.env && [ -x /tmp/defender ] && [ -x /tmp/defender-entry.sh ]'
    - if docker run --rm verify-app; then echo "Container started without TEAM_NAME; it should have exited"; exit 1; fi

    # 2. Same image with a stub in place of the real Defender, to test the wrapper logic
    - |
      cat > Dockerfile.stub-verify <<EOF
      FROM verify-app
      RUN printf '#!/bin/sh\nenv | sort\n' > /tmp/defender && chmod 755 /tmp/defender
      EOF
    - docker build -t verify-stub -f Dockerfile.stub-verify .
    - OUT=$(docker run --rm -e TEAM_NAME=ci-test verify-stub)
    - echo "$OUT" | grep -q '^DEFENDER_APP_ID=ci-test$'
    - echo "$OUT" | grep -q '^DEFENDER_TYPE=appEmbedded$'
    - echo "$OUT" | grep -q '^WS_ADDRESS=wss://'
    # A runtime value must override the file
    - OUT2=$(docker run --rm -e TEAM_NAME=ci-test -e WS_ADDRESS=wss://override.example:443 verify-stub)
    - echo "$OUT2" | grep -q '^WS_ADDRESS=wss://override.example:443$'
