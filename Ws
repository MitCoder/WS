# ---------------------------------------------------------------
# GLOSSARY, in the order the terms show up below
#
# GitLab server   : stores the code and this file, and decides what runs.
#                   It does NOT run jobs.
# RUNNER          : a worker program (on a VM or inside a Kubernetes
#                   cluster) that asks GitLab for jobs and runs them.
# EXECUTOR        : the runner's "how to run a job" setting. It decides
#                   whether jobs run in containers (Docker or Kubernetes
#                   executor) or directly on the machine (shell executor).
# CONTAINER IMAGE : a packaged filesystem with tools inside, like a
#                   toolbox. Read-only and stored in a registry.
# CONTAINER       : a running copy of an image. Each job gets a fresh one,
#                   and it is deleted when the job ends.
# SERVICE         : a second container started next to the job container,
#                   for example a Docker daemon (docker:dind).
# ---------------------------------------------------------------

stages: [build, scan]

# ----- Consuming app: only this part is written by the app team -----
# include:
#   - component: $CI_SERVER_FQDN/security/image-scan/image-scan@1.0.0
#     inputs:
#       image: $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA

build-image:
  stage: build
  # `image:` names the CONTAINER IMAGE that this job runs in.
  # The RUNNER pulls it from the registry and starts a CONTAINER from it.
  # docker:cli is a toolbox containing the `docker` command.
  image: docker:cli
  # `services:` starts a SECOND container beside the job container.
  # docker:dind is a Docker daemon, so `docker build` has an engine to talk to.
  # It needs a privileged runner (an EXECUTOR/runner setting, not your pipeline).
  services: [docker:dind]
  variables:
    # Tells the docker command in the job container where the daemon is.
    DOCKER_HOST: tcp://docker:2376
    DOCKER_TLS_CERTDIR: /certs
    DOCKER_TLS_VERIFY: "1"
    DOCKER_CERT_PATH: /certs/client
  script:
    # These commands run INSIDE the job CONTAINER, not on the runner machine.
    - docker build -t "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA" .

# ----- Component: written once by your team -----
image-scan:
  stage: scan
  # Your twistcli CONTAINER IMAGE. twistcli is baked into it, so the
  # runner installs nothing: it pulls this image and starts a container.
  image: registry.example.com/security/twistcli:1.0
  services: [docker:dind]
  variables:
    DOCKER_HOST: tcp://docker:2376
    DOCKER_TLS_CERTDIR: /certs
    DOCKER_TLS_VERIFY: "1"
    DOCKER_CERT_PATH: /certs/client
  script:
    # PRISMA_CONSOLE_URL and PRISMA_TOKEN are CI/CD variables. GitLab
    # injects them into the job CONTAINER as environment variables.
    - >
      twistcli images scan
      --address "$PRISMA_CONSOLE_URL"
      --token "$PRISMA_TOKEN"
      --docker-address tcp://docker:2376
      --docker-tlscacert /certs/client/ca.pem
      --docker-tlscert /certs/client/cert.pem
      --docker-tlskey /certs/client/key.pem
      --details
      "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA"
  # The CONTAINER is deleted when this job ends. Only `artifacts:` survive.
