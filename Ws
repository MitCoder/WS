#!/usr/bin/env python3
"""ORCHESTRATOR (runs on the orchestrator EC2; it is NOT a worker).

Step 1 only: raise a worker fleet's ASG desired capacity.
The workers are the EC2 instances the ASG launches from its launch template.

Usage:
  python3 orchestrator.py add-worker docker      # desired +1 (up to max)
  python3 orchestrator.py status docker          # show desired / instances
Env: AWS_REGION, WORKER_FLEETS, DRY_RUN=1 (change nothing)
  WORKER_FLEETS example: [{"name":"docker","asg":"claude-docker-asg","max":1}]
"""
import argparse
import json
import logging
import os

import boto3

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("orchestrator")


class WorkerFleet:
    """An ASG whose instances are workers. Its launch template decides the worker type."""

    def __init__(self, name, asg_name, max_size, autoscaling, dry_run=False):
        self.name = name
        self.asg_name = asg_name
        self.max_size = max_size
        self.autoscaling = autoscaling
        self.dry_run = dry_run

    def _group(self):
        groups = self.autoscaling.describe_auto_scaling_groups(
            AutoScalingGroupNames=[self.asg_name])["AutoScalingGroups"]
        if not groups:
            raise SystemExit(f"ASG {self.asg_name} not found")
        return groups[0]

    def status(self):
        group = self._group()
        instances = [(i["InstanceId"], i["LifecycleState"]) for i in group["Instances"]]
        log.info("fleet %s: desired=%d min=%d max=%d instances=%s",
                 self.name, group["DesiredCapacity"], group["MinSize"], group["MaxSize"], instances)

    def add_worker(self):
        if self.dry_run:
            log.info("[dry-run] asg %s would add one worker", self.asg_name)
            return
        desired = self._group()["DesiredCapacity"]
        if desired >= self.max_size:
            log.info("asg %s already at max (%d workers)", self.asg_name, desired)
            return
        self.autoscaling.set_desired_capacity(
            AutoScalingGroupName=self.asg_name,
            DesiredCapacity=desired + 1, HonorCooldown=False)
        log.info("asg %s desired %d -> %d", self.asg_name, desired, desired + 1)


def create_worker_fleets(fleets_json, autoscaling, dry_run=False):
    return {
        item["name"]: WorkerFleet(item["name"], item["asg"], int(item["max"]),
                                  autoscaling, dry_run)
        for item in json.loads(fleets_json)
    }


def main():
    parser = argparse.ArgumentParser(description="Orchestrator: ASG test")
    parser.add_argument("action", choices=["add-worker", "status"])
    parser.add_argument("fleet")
    args = parser.parse_args()

    autoscaling = boto3.client("autoscaling", region_name=os.environ["AWS_REGION"])
    fleets = create_worker_fleets(os.environ["WORKER_FLEETS"], autoscaling,
                                  dry_run=os.environ.get("DRY_RUN") == "1")
    if args.fleet not in fleets:
        raise SystemExit(f"fleet '{args.fleet}' is not in WORKER_FLEETS: {list(fleets)}")

    fleet = fleets[args.fleet]
    if args.action == "add-worker":
        fleet.add_worker()
    fleet.status()


if __name__ == "__main__":
    main()
