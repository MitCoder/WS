
#!/bin/bash
# Orchestrator bootstrap, rendered by Terraform and run by cloud-init at boot.
set -euo pipefail

yum install -y python3 python3-pip

mkdir -p /opt/orchestrator
python3 -m venv /opt/orchestrator/venv

# boto3 into the venv. Use an internal package index when one is configured.
PIP_INDEX='${pip_index_url}'
if [ -n "$PIP_INDEX" ]; then
  /opt/orchestrator/venv/bin/pip install --index-url "$PIP_INDEX" boto3
else
  /opt/orchestrator/venv/bin/pip install boto3
fi

# orchestrator.py, embedded as base64 by Terraform
echo '${script_b64}' | base64 -d > /opt/orchestrator/orchestrator.py
/opt/orchestrator/venv/bin/python -m py_compile /opt/orchestrator/orchestrator.py

# Settings the script reads from the environment
cat > /etc/orchestrator.env <<'EOF'
AWS_REGION=${region}
WORKER_FLEETS='${worker_fleets_json}'
EOF
chmod 644 /etc/orchestrator.env

# Wrapper: loads the settings, then runs the script with the venv's Python
cat > /usr/local/bin/orchestrator <<'EOF'
#!/bin/bash
set -a; . /etc/orchestrator.env; set +a
exec /opt/orchestrator/venv/bin/python /opt/orchestrator/orchestrator.py "$@"
EOF
chmod 755 /usr/local/bin/orchestrator
