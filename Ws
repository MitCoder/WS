#!/usr/bin/env python3
"""WORKER: one instance, one job. Runs on an EC2 launched by a worker ASG.

Steps: 1 read a job from the SQS queue -> 2 mark it running -> 3 run the prompt in Docker
       -> 4 save output + status to the output bucket -> 5 delete the message -> exit.
(The shell wrapper then terminates the instance.)

Strategy             JobRunner: DockerRunner today; add FirecrackerRunner to build_runner() later.
Dependency injection build_runner() and main() wire everything from the environment.

Queue message: {"job_id": "...", "prompt": "..."}   or   {"job_id": "...", "key": "inbox/x.json"}
Buckets: DATA_BUCKET   = input  (job specs, later code)      -> read only
         OUTPUT_BUCKET = output (results/<id>/, status/<id>) -> write only
Env: AWS_REGION, QUEUE_URL, OUTPUT_BUCKET, DATA_BUCKET (only for jobs with "key"),
     DRY_RUN (1 = log the job and put it back)
     docker runner: IMAGE, JOB_TIMEOUT
       CONTAINER_CMD  command run inside the image, default "claude -p"; the prompt is appended.
                      Use "echo" to test the whole flow without calling Claude.
       CLAUDE_ARGS    extra arguments after the prompt (empty when CONTAINER_CMD is "echo")
       MODEL_ID, HAIKU_MODEL_ID  optional Bedrock model settings
       DOCKER_ARGS    optional extra docker run arguments (for example credentials when local)
"""
import json
import logging
import os
import re
import shlex
import subprocess
from abc import ABC, abstractmethod

import boto3

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("worker")

ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
KEY_RE = re.compile(r"^inbox/[A-Za-z0-9._/-]{1,200}\.json$")


# ------------------------------------------------------------ Strategy: how the job is run
class JobRunner(ABC):
    @abstractmethod
    def run(self, job):
        """Run the job. Return (exit_code, output_text)."""


class DockerRunner(JobRunner):
    def __init__(self, image, region, command, claude_args, timeout,
                 model_id="", haiku_model_id="", docker_args=()):
        self.image = image
        self.region = region
        self.command = list(command)          # for example ["claude", "-p"] or ["echo"]
        self.claude_args = list(claude_args)
        self.timeout = timeout
        self.model_id = model_id
        self.haiku_model_id = haiku_model_id
        self.docker_args = list(docker_args)

    def run(self, job):
        name = f"agent-{job['job_id']}"
        env_vars = {"AWS_REGION": self.region,
                    "CLAUDE_CODE_USE_BEDROCK": "1",
                    "ANTHROPIC_MODEL": self.model_id,
                    "ANTHROPIC_DEFAULT_HAIKU_MODEL": self.haiku_model_id}
        env_args = [a for k, v in env_vars.items() if v for a in ("-e", f"{k}={v}")]
        cmd = (["docker", "run", "--rm", "--name", name] + env_args + self.docker_args
               + [self.image] + self.command + [job["prompt"]] + self.claude_args)
        log.info("docker run starting (timeout %ds): %s", self.timeout, name)
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=self.timeout)
            return proc.returncode, proc.stdout + proc.stderr
        except subprocess.TimeoutExpired:
            subprocess.run(["docker", "rm", "-f", name], capture_output=True)
            return 124, f"TIMEOUT after {self.timeout}s\n"


def build_runner(name, env):
    if name == "docker":
        return DockerRunner(
            image=env["IMAGE"],
            region=env["AWS_REGION"],
            command=shlex.split(env.get("CONTAINER_CMD") or "claude -p"),
            claude_args=shlex.split(env.get("CLAUDE_ARGS", "")),
            timeout=int(env["JOB_TIMEOUT"]),
            model_id=env.get("MODEL_ID", ""),
            haiku_model_id=env.get("HAIKU_MODEL_ID", ""),
            docker_args=shlex.split(env.get("DOCKER_ARGS", "")))
    raise SystemExit(f"unknown RUNNER '{name}' (only 'docker' is built)")


# ------------------------------------------------------------ queue (input) and results (output)
def get_job(sqs, s3, queue_url, data_bucket, visibility, attempts=3):
    """Step 1: take one valid job from the queue. Returns (job, receipt_handle) or (None, None)."""
    for attempt in range(1, attempts + 1):
        log.info("polling queue (%d/%d)", attempt, attempts)
        response = sqs.receive_message(QueueUrl=queue_url, MaxNumberOfMessages=1,
                                       WaitTimeSeconds=20, VisibilityTimeout=visibility)
        for message in response.get("Messages", []):
            receipt = message["ReceiptHandle"]
            try:
                body = json.loads(message["Body"])
                job_id = str(body.get("job_id", ""))
                prompt = body.get("prompt")
                if prompt is None and data_bucket and KEY_RE.match(str(body.get("key", ""))):
                    log.info("reading job spec s3://%s/%s", data_bucket, body["key"])
                    spec = json.loads(s3.get_object(Bucket=data_bucket, Key=body["key"])["Body"].read())
                    prompt = spec.get("prompt")
                if ID_RE.match(job_id) and str(prompt or "").strip():
                    log.info("got job %s", job_id)
                    return {"job_id": job_id, "prompt": prompt}, receipt
            except Exception:
                log.exception("could not read message")
            log.error("bad message, deleting: %s", message["Body"][:200])
            sqs.delete_message(QueueUrl=queue_url, ReceiptHandle=receipt)
    return None, None


def write_status(s3, output_bucket, job_id, state, **extra):
    """Small JSON progress file: status/<job_id>.json in the output bucket."""
    try:
        body = json.dumps({"state": state, **extra}).encode()
        s3.put_object(Bucket=output_bucket, Key=f"status/{job_id}.json", Body=body)
    except Exception:
        log.exception("could not write status %s for %s", state, job_id)


def save_result(s3, output_bucket, job_id, output):
    s3.put_object(Bucket=output_bucket, Key=f"results/{job_id}/out.log", Body=output.encode())


# ------------------------------------------------------------ Wiring (dependency injection)
def main():
    env = os.environ
    region = env["AWS_REGION"]
    queue_url = env["QUEUE_URL"]
    data_bucket = env.get("DATA_BUCKET", "")
    output_bucket = env["OUTPUT_BUCKET"]
    timeout = int(env.get("JOB_TIMEOUT", "3600"))

    sqs = boto3.client("sqs", region_name=region)
    s3 = boto3.client("s3", region_name=region)

    job, receipt = get_job(sqs, s3, queue_url, data_bucket, visibility=timeout + 300)
    if job is None:
        log.info("no job found; exiting")
        return

    if env.get("DRY_RUN") == "1":
        log.info("DRY RUN: job %s: %s", job["job_id"], job["prompt"][:200])
        sqs.change_message_visibility(QueueUrl=queue_url, ReceiptHandle=receipt,
                                      VisibilityTimeout=0)   # put it back for the next test
        return

    runner = build_runner(env.get("RUNNER", "docker"), env)
    job_id = job["job_id"]

    write_status(s3, output_bucket, job_id, "running")                    # step 2
    try:
        exit_code, output = runner.run(job)                               # step 3
    except Exception as e:
        log.exception("job %s failed to run", job_id)
        exit_code, output = 1, f"worker error: {e}\n"

    save_result(s3, output_bucket, job_id, output)                        # step 4
    write_status(s3, output_bucket, job_id, "done" if exit_code == 0 else "failed",
                 exit_code=exit_code)
    log.info("job %s finished, exit code %d", job_id, exit_code)
    sqs.delete_message(QueueUrl=queue_url, ReceiptHandle=receipt)         # step 5


if __name__ == "__main__":
    main()
